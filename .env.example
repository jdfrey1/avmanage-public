# =============================================================================
# avManage — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=avmanage
POSTGRES_PASSWORD=change_me
POSTGRES_DB=avmanage

# --- Sessions ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=change_me

# true when the app is served over HTTPS (reverse proxy, Cloudflare Tunnel…); false for
# plain http:// on your own network.
COOKIE_SECURE=false

# Public address of the app, used in emailed links (password resets, invitations).
# Optional — without it the address the request came in on is used.
PUBLIC_URL=

# --- Where persistent data lives on the host (production compose file) ---
# Holds db_data/, uploads/ and backups/. Defaults to ./data next to the compose file.
#DATA_PATH=./data

# --- Optional: Anthropic API key ---
# Enables reading Hobbs/Flight meters from a photo, the documents/logbook chat and
# AI text extraction. Leave blank to turn these off; everything else works without it.
ANTHROPIC_API_KEY=

# --- Optional: FlightAware AeroAPI key ---
# Flight tracks for FlightAware alert emails. Can also be entered in Settings → FlightAware.
FLIGHTAWARE_API_KEY=

# Time zone for flight-alert times and the calendar feed (IANA name).
APP_TIMEZONE=America/New_York

# --- Optional: Google (Calendar sync, Drive archive, Gmail reports/invites/alerts) ---
# OAuth client from your own Google Cloud project — see docs/INTEGRATIONS.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Calendar to push reservations to; defaults to the connected account's primary calendar.
GOOGLE_CALENDAR_ID=
